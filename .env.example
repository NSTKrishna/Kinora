# Kinora — copy to .env.local and fill in. Never commit .env* files.

# Which generation provider the server uses.
#   mock   = sample outputs after a fake delay, costs nothing (default for local dev)
#   fal    = real providers: Cloudflare Workers AI for stills, fal.ai for video.
#            If a provider refuses us, the render fails and the credits come back.
#   hybrid = the same real providers, but when one cannot serve us at all — an
#            exhausted balance, a rejected key, a rate limit, an outage — the
#            render returns a placeholder clip badged as one, instead of failing.
#            A refused prompt or an invalid request still fails: only our own
#            failures are stood in for. Best for a deployment people will try.
# Anything unrecognised means mock, so a typo can never start spending.
PROVIDER=mock

# Kinds pinned to the mock even while the rest runs live. Comma separated.
# A still on Cloudflare Workers AI is free; a clip is billed per second of
# output. MOCK_KINDS=video shows real image generation end to end at no cost.
# This can only ever reduce spend — it never turns a provider on.
MOCK_KINDS=video

# fal.ai — runs video, and any image model Cloudflare cannot (reference images).
FAL_KEY=

# Cloudflare Workers AI — runs plain text-to-image for free, within a daily
# allowance of 10,000 neurons (~170 images/day, resets daily, no card needed).
# Both are required together; without them stills fall back to fal.
#   Account ID: dash.cloudflare.com -> Workers & Pages -> Account ID
#   API token:  dash.cloudflare.com/profile/api-tokens -> Workers AI (Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Postgres (Neon) — pooled connection string
DATABASE_URL=

# Cloudinary — where every image lives: the photos people upload for Effects
# and the stills Cloudflare Workers AI renders. Free tier, no card.
# cloudinary.com/console -> Product Environment Credentials.
# Without all three, uploads fall back to "paste a URL" and generated stills
# are kept in Postgres instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob — the previous upload path. Only needed to keep URLs recorded
# before the move to Cloudinary resolving; new uploads do not use it.
BLOB_READ_WRITE_TOKEN=

# Public base URL of the deployment (used for absolute links / OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign the guest session cookie (any long random string).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Ceiling on credits the whole demo may spend per UTC day. Past it, generation
# returns a clear "demo capacity reached" error instead of a fake result.
# Unset defaults to 5000 — set it explicitly before pointing at a funded fal
# account, because that default is roughly $60/day of headroom.
DAILY_CREDIT_CAP=5000

# ----------------------------------------------------------------- seeding
# Only needed to re-run `scripts/seed-demo.ts`, never at runtime.

# Where seed media comes from: "pexels" for licensed reference footage
# (credited in the UI), or unset to generate it through the configured provider.
SOURCE=

# Pexels API key, required when SOURCE=pexels. pexels.com/api
PEXELS_API_KEY=

# Base URL the seed script points at when it generates through the app.
SEED_BASE_URL=http://localhost:3000
