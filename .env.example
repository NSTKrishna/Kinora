# Kinora — copy to .env.local and fill in. Never commit .env* files.

# Which generation provider the server uses.
#   mock = sample outputs after a fake delay, costs nothing (default for local dev)
#   fal  = real providers: Cloudflare Workers AI for stills, fal.ai for video
PROVIDER=mock

# fal.ai — runs video, and any image model Cloudflare cannot (reference images).
FAL_KEY=

# Cloudflare Workers AI — runs plain text-to-image for free, within a daily
# allowance of 10,000 neurons (~170 images/day, resets daily, no card needed).
# Both are required together; without them stills fall back to fal.
#   Account ID: dash.cloudflare.com -> Workers & Pages -> Account ID
#   API token:  dash.cloudflare.com/profile/api-tokens -> Workers AI (Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Postgres (Neon) — pooled connection string
DATABASE_URL=

# Vercel Blob — uploads
BLOB_READ_WRITE_TOKEN=

# Public base URL of the deployment (used for absolute links / OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign the guest session cookie (any long random string).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Ceiling on credits the whole demo may spend per UTC day. Past it, generation
# returns a clear "demo capacity reached" error instead of a fake result.
DAILY_CREDIT_CAP=5000
